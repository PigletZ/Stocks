DATABASE_URL=sqlite:///./stocks.db
TUSHARE_TOKEN=
# 如需公网访问，填写公网 IP 或域名（不带 http://）
PUBLIC_HOST=
# 留空使用 backend/.cache/system；仅保存非敏感设置及任务状态
SYSTEM_STATE_DIR=
# 留空使用 backend/backups；由 scripts/backup_database.py 生成一致性备份
BACKUP_DIR=

# 必填；仅在服务器环境或未入库的 .env 中填写真实值
AUTH_USERNAME=
AUTH_PASSWORD=
# 至少 32 字符，使用随机生成的独立密钥
AUTH_SECRET=
AUTH_TOKEN_TTL=604800
